include "InstantPageButtonAction.fbs";

namespace TelegramCore;

// The shared codec behind `RichText.textButton` and `InstantPageBlock.buttonRow` (see
// SyncCore_InstantPageButton.swift): `InstantPageButtonAction` mirrors the subset of
// `Api.InlineButtonType` a page button can carry, `InstantPageButton` the shared button shape.
// `textButton` and `pageButton` (TL) give both constructors the same fields, so one table serves both.

// NOTE: InstantPageButtonAction_Value union and all InstantPageButtonAction_* tables are defined
// in InstantPageButtonAction.fbs (included above). This file only defines the InstantPageButton
// table which references them.

table InstantPageButton {
    text:RichText (id: 0, required);
    action:InstantPageButtonAction (id: 1, required);
    // `ReplyMarkupButton.Style.Color?` raw value; -1 when absent.
    color:int32 (id: 2);
    // `richButtonStyle`'s link bit, stored separately from `color`.
    isLink:bool (id: 3);
}
